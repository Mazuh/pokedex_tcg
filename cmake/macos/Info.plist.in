<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the macOS .app bundle CMake builds (MACOSX_BUNDLE). The ${...}
  tokens are filled by CMake from the target's MACOSX_BUNDLE_* properties.

  The key that MATTERS is NSCameraUsageDescription: without it macOS refuses camera
  access and Qt's QCameraPermission request fails ("... include the required usage
  description in your Info.plist"). A REAL bundle Info.plist (this file, landing at
  Contents/Info.plist) is what [NSBundle mainBundle].infoDictionary reads and what
  LaunchServices/TCC register — which a bare executable with an embedded __info_plist
  section does not reliably provide, hence the bundle.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <!-- Must equal the .app's file name (see POKEDEX_APP_NAME in CMakeLists.txt): macOS
         ignores a display name that disagrees with the bundle's own file name, so the two
         are kept in lockstep rather than allowed to drift. CFBundleName above stays short
         because it, not this, titles the menu-bar application menu. -->
    <key>CFBundleDisplayName</key>
    <string>${POKEDEX_APP_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSCameraUsageDescription</key>
    <string>Pokedex TCG uses the camera to scan physical cards so it can read their set and collector number.</string>
</dict>
</plist>
